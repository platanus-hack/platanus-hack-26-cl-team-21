# Homebrew Postgres (default). Docker alternative: postgres://postgres:postgres@localhost:5432/observatorio
# On Render this is injected from the olm-db database.
DATABASE_URL=postgres://localhost:5432/observatorio

# Object storage (S3 API). Defaults: MinIO from docker-compose (`docker compose up -d`, bucket created on startup).
# Production is Backblaze B2: S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com, S3_REGION=us-east-005,
# plus the bucket and a key limited to it (set in the Render dashboard, never committed).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=olm-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Worker (process_session). The Claude API key; on Render set it in the dashboard (sync: false).
ANTHROPIC_API_KEY=
# Until object storage is wired, the worker reads <LOCAL_MEDIA_DIR>/<upload_id>/video.mp4 and frames.csv.
LOCAL_MEDIA_DIR=
# Optional model overrides (defaults: claude-haiku-5-5 for detection, claude-opus-5-5 for extraction).
# DETECTION_MODEL=
# EXTRACTION_MODEL=
