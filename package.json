{
  "name": "observatorio",
  "private": true,
  "workspaces": [
    "db",
    "storage",
    "web",
    "worker"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev:web": "npm run dev -w web",
    "dev:worker": "npm run dev -w worker",
    "db:generate": "npm run generate -w db",
    "db:migrate": "npm run migrate -w db",
    "db:test": "npm run test -w db",
    "db:seed": "npm run seed -w db",
    "mock:api": "node tools/mock-api/main.mjs",
    "mock:api:test": "node --test tools/mock-api/server.test.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "storage:test": "npm run test -w storage",
    "storage:test:integration": "npm run test:integration -w storage",
    "eval": "tsx --env-file-if-exists=.env data/eval/run.ts",
    "eval:test": "tsx --test data/eval/*.test.ts",
    "eval:typecheck": "tsc -p data"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
